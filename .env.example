MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_HLS_URL=http://127.0.0.1:8888
MEDIAMTX_WEBRTC_URL=http://127.0.0.1:8889
CHAT_DB_PATH=.data/chat.sqlite
CHAT_ENABLED=false
CHAT_DATABASE_LIMIT_BYTES=2147483648
CHAT_MINIMUM_FREE_BYTES=10737418240
# Generate each independently with: openssl rand -hex 32
CHAT_TAG_HMAC_SECRET=replace_with_a_random_64_character_value
CENTRIFUGO_TOKEN_HMAC_SECRET=replace_with_another_random_64_character_value
CENTRIFUGO_API_KEY=replace_with_a_third_random_64_character_value
CENTRIFUGO_API_URL=http://127.0.0.1:8000/api
THUMBNAIL_DIR=.data/thumbnails
# Production prefers the dedicated read-only API key generated by the Oracle
# Terraform for all OCI SDK calls. Inventory and monitoring fall back to the
# VM instance principal when the key variables are omitted.
OCI_STATS_ENABLED=false
# OCI_USAGE_TENANCY_OCID=
# OCI_USAGE_USER_OCID=
# OCI_USAGE_FINGERPRINT=
# OCI_USAGE_PRIVATE_KEY_PATH=
# OCI_FREE_A1_OCPU_HOURS=3000
# OCI_FREE_A1_MEMORY_GB_HOURS=18000
# OCI_FREE_BLOCK_STORAGE_GB=200
# OCI_FREE_OUTBOUND_GB=10000
AUTH_DB_PATH=.data/auth.sqlite
BETTER_AUTH_URL=http://localhost:3000
# Optional provider sign-in. Set both values for each enabled provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Generate independently with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace_with_a_random_64_character_value
INTERNAL_AUTH_SECRET=replace_with_another_random_64_character_value
MEDIAMTX_AUTH_SECRET=replace_with_a_third_random_64_character_value

# Verification and password recovery email. Local mail receivers may disable TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
