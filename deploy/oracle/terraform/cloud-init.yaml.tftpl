#cloud-config
package_update: true
package_upgrade: true

packages:
  - ca-certificates
  - curl
  - docker.io
  - docker-compose-v2
  - git
  - rsync
  - ufw

write_files:
  - path: /etc/sysctl.d/90-mediamtx.conf
    permissions: "0644"
    content: |
      net.core.rmem_max=2500000
      net.core.wmem_max=2500000

runcmd:
  - [systemctl, enable, --now, docker]
  - [usermod, -aG, docker, ubuntu]
  - [sysctl, --system]
  - [ufw, default, deny, incoming]
  - [ufw, default, allow, outgoing]
  - [ufw, allow, from, "${ssh_allowed_cidr}", to, any, port, "22", proto, tcp]
  - [ufw, allow, "80/tcp"]
  - [ufw, allow, "443/tcp"]
  - [ufw, allow, "443/udp"]
  - [ufw, allow, "8189/udp"]
  - [ufw, allow, "8189/tcp"]
  - [ufw, --force, enable]

final_message: "MediaMTX viewer host bootstrap completed"
