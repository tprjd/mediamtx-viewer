compartment_ocid          = "ocid1.tenancy.oc1..replace-me"
region                    = "eu-frankfurt-1"
oci_profile               = "mediamtx-deploy"
oci_auth                  = "SecurityToken"
hostname                  = "frankerzspam.duckdns.org"
ssh_public_key_path       = "~/.ssh/id_ed25519.pub"
ssh_allowed_cidr          = "203.0.113.10/32"
availability_domain_index = 0

# The Always Free-oriented defaults are 1 Ampere A1 OCPU, 6 GiB RAM, and a
# 50 GiB boot volume. Override only after checking tenancy usage and limits.
# instance_ocpus       = 1
# instance_memory_gb   = 6
# boot_volume_size_gb = 50

# Pin an image when exact rebuild reproducibility is more important than
# automatically selecting the newest compatible Ubuntu 24.04 image.
# image_ocid = "ocid1.image.oc1.eu-frankfurt-1.replace-me"
