{
	servers {
		protocols h1 h2
	}
}

{$PUBLIC_HOSTNAME} {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
	}

	@account_protected not path /login /register /registration-pending /reset-password /api/auth/* /api/internal/authorize /_next/* /favicon.ico /publish/whep/*

	forward_auth @account_protected viewer:3000 {
		uri /api/internal/authorize
		header_up X-Internal-Auth {$INTERNAL_AUTH_SECRET}
	}

	handle_path /publish/whep/* {
		reverse_proxy mediamtx:8889 {
			header_down Location ^/(.*)$ /publish/whep/$1
		}
	}

	handle_path /media/hls/* {
		reverse_proxy mediamtx:8888 {
			header_up -Authorization
			header_up -Cookie
		}
	}

	handle_path /media/whep/* {
		reverse_proxy mediamtx:8889 {
			header_up -Authorization
			header_up -Cookie
			header_down Location ^/(.*)$ /media/whep/$1
		}
	}

	handle {
		reverse_proxy viewer:3000
	}
}
