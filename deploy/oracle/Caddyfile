{
	servers {
		protocols h1 h2 h3
	}
}

# Next.js closes idle upstream connections after five seconds.
(viewer_transport) {
	transport http {
		keepalive 4s
	}
}

{$PUBLIC_HOSTNAME} {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
	}

	@account_protected not path /login /register /registration-pending /reset-password /forgot-password /verify-email /api/auth/* /api/internal/authorize /api/obs-setup/device/start /api/obs-setup/device/poll /_next/* /favicon.ico /icon.svg /publish/whip/*

	forward_auth @account_protected viewer:3000 {
		import viewer_transport
		uri /api/internal/authorize
		header_up X-Internal-Auth {$INTERNAL_AUTH_SECRET}
		# Authenticate with ordinary HTTP before the upstream WebSocket upgrade.
		header_up -Connection
		header_up -Upgrade
	}

	handle_path /publish/whep/* {
		reverse_proxy mediamtx:8889 {
			header_up -Cookie
			header_down Location ^/(.*)$ /publish/whep/$1
		}
	}

	handle_path /publish/whip/* {
		# This unauthenticated prefix accepts publisher endpoints only.
		@whip_endpoint path_regexp whip_endpoint ^/.+/whip(/[A-Za-z0-9_-]+)?$
		route {
			reverse_proxy @whip_endpoint mediamtx:8889 {
				header_up -Cookie
				header_down Location ^/(.*)$ /publish/whip/$1
			}
			respond 404
		}
	}

	handle_path /media/hls/* {
		reverse_proxy mediamtx:8888 {
			header_up -Authorization
			header_up -Cookie
		}
	}

	handle_path /media/whep/* {
		reverse_proxy mediamtx:8889 {
			header_up -Authorization
			header_up -Cookie
			header_down Location ^/(.*)$ /media/whep/$1
		}
	}

	@channel_events path /api/channel-events
	handle @channel_events {
		reverse_proxy viewer:3000 {
			import viewer_transport
			flush_interval -1
		}
	}

	handle_path /chat/realtime/* {
		reverse_proxy centrifugo:8000 {
			header_up -Authorization
			header_up -Cookie
		}
	}

	handle {
		reverse_proxy viewer:3000 {
			import viewer_transport
		}
	}
}
