PUBLIC_HOSTNAME=frankerzspam.duckdns.org
VIEWER_USERNAME=gigachad
# Generate with: caddy hash-password --plaintext 'your-password'
# Keep a real bcrypt hash single-quoted so Compose does not expand its dollars.
VIEWER_PASSWORD_HASH='$2a$14$replace_with_a_real_bcrypt_hash'
# Generate each independently with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace_with_a_random_64_character_value
INTERNAL_AUTH_SECRET=replace_with_another_random_64_character_value
