logLevel: info
logDestinations: [stdout]

authMethod: internal
authInternalUsers:
  - user: any
    pass:
    ips: ["172.28.0.0/24", "127.0.0.1", "::1"]
    permissions:
      - action: read
        path:
      - action: playback
        path:
      - action: api
      - action: metrics

api: true
apiAddress: :9997
metrics: true
metricsAddress: :9998
pprof: false
playback: false

rtsp: true
rtspAddress: :8554
rtspTransports: [tcp]
udpReadBufferSize: 2500000
rtmp: false
srt: false
moq: false

hls: true
hlsAddress: :8888
hlsEncryption: false
hlsAllowOrigins: ["https://frankerzspam.duckdns.org"]
hlsAlwaysRemux: true
hlsVariant: lowLatency

webrtc: true
webrtcAddress: :8889
webrtcEncryption: false
webrtcAllowOrigins: ["https://frankerzspam.duckdns.org"]
webrtcLocalUDPAddress: :8189
webrtcLocalTCPAddress: :8189
webrtcIPsFromInterfaces: false
webrtcAdditionalHosts: ["158.180.29.172"]

paths:
  live:
    source: publisher
    overridePublisher: false
  "~^channels/[a-z0-9]+(?:-[a-z0-9]+)*$":
    source: publisher
    overridePublisher: false
