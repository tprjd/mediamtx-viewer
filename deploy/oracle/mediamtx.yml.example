logLevel: info
logDestinations: [stdout]

# Docker Compose overrides this with HTTP authorization (MTX_AUTHHTTPADDRESS).
# The internal fallback intentionally grants no publishing permission if
# MediaMTX is started alone.
authMethod: internal
authInternalUsers:
  - user: any
    pass:
    ips: ["172.28.0.0/24", "127.0.0.1", "::1"]
    permissions:
      - action: read
        path:
      - action: playback
        path:
      - action: api
      - action: metrics

api: true
apiAddress: :9997
metrics: true
metricsAddress: :9998
pprof: false
playback: false

rtsp: true
rtspAddress: :8554
rtspTransports: [tcp]
udpReadBufferSize: 2500000
rtmp: true
rtmpEncryption: "no"
rtmpAddress: :1935
# RTMPS (rtmpsAddress: :1936, rtmpEncryption: optional/strict, rtmpServerKey/Cert)
# is a config-ready follow-up once TLS certs are mounted for MediaMTX; until then
# the token rides in the plain-RTMP URL (see plan).
# rtmpsAddress: :1936
srt: false
moq: false

hls: true
hlsAddress: :8888
hlsEncryption: false
hlsAllowOrigins: ["https://frankerzspam.duckdns.org"]
hlsAlwaysRemux: true
hlsVariant: lowLatency
hlsSegmentDuration: 2s
hlsPartDuration: 200ms

webrtc: true
webrtcAddress: :8889
webrtcEncryption: false
webrtcAllowOrigins: ["https://frankerzspam.duckdns.org"]
webrtcLocalUDPAddress: :8189
webrtcLocalTCPAddress: :8189
webrtcIPsFromInterfaces: false
webrtcAdditionalHosts: ["158.180.29.172"]

paths:
  live:
    source: publisher
    overridePublisher: true
  "~^channels/[a-z0-9]+(?:-[a-z0-9]+)*$":
    source: publisher
    overridePublisher: true
