# Store the completed file outside the checkout with mode 0600.
# Use the Prometheus remote write URL and tenant ID from your Grafana Cloud stack.
MONITORING_INSTANCE=viewer-vm
GRAFANA_METRICS_URL=
GRAFANA_METRICS_USER=
# Use a stack-scoped access policy with only metrics:write.
GRAFANA_METRICS_TOKEN=
# Use the existing Compose project name for application services.
MONITORING_PROJECT=mediamtx-viewer
# Use a separate stack-scoped access policy with only logs:write.
GRAFANA_LOGS_URL=
GRAFANA_LOGS_USER=
GRAFANA_LOGS_TOKEN=
