        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "monitoring_service_restarts_total{instance=\"$instance\",service=~\"$service\"}",
          "legendFormat": "{{service}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": false,
          "range": true
        }
      ],
      "description": "Docker restart count resets when a container is replaced. State logs and the start-time chart retain replacement evidence."
    },
    {
      "id": 6,
      "title": "Last container start",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "custom": {
            "spanNulls": false
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textSize": {
          "title": 12,
          "value": 12
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "monitoring_service_started_seconds{instance=\"$instance\",service=~\"$service\"} * 1000",
          "legendFormat": "{{service}}",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Shows the latest observation only."
    },
