{
  "uid": "mediamtx-services",
  "title": "MediaMTX service health and logs",
  "tags": [
    "mediamtx",
    "monitoring"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "utc",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "Service state and approved log events. Unknown health is -1. Release filters the logs only. Raw messages are withheld; discarded records and gaps are counted. Detailed Cloud history: 14 days.",
  "links": [
    {
      "title": "VM health for this time range",
      "type": "link",
      "url": "/d/mediamtx-vm/mediamtx-vm-health",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Channel activity for this time range",
      "type": "link",
      "url": "/d/mediamtx-channels/mediamtx-channel-activity-and-traffic",
      "keepTime": true,
      "includeVars": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Metrics source",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1
      },
      {
        "name": "logs",
        "label": "Logs source",
        "type": "datasource",
        "query": "loki",
        "refresh": 1
      },
      {
        "name": "instance",
        "label": "VM",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(monitoring_service_collection_success, instance)",
          "refId": "instances"
        },
        "refresh": 1
      },
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "viewer,caddy,mediamtx,mediamtx-health,centrifugo,thumbnailer,discord-notifier",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "release",
        "label": "Release (logs)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(monitoring_application_info{instance=\"$instance\"}, version)",
          "refId": "releases"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Service running",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Stopped or missing",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Running",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "monitoring_service_running{instance=\"$instance\",service=~\"$service\"}",
          "legendFormat": "{{service}}",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "1 running; 0 stopped or missing. No value means collection failed. Shows the latest observation only."
    },
    {
      "id": 2,
      "title": "Docker health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "No check",
                  "color": "gray",
                  "index": 0
                },
                "0": {
                  "text": "Unhealthy",
                  "color": "red",
                  "index": 1
                },
                "1": {
                  "text": "Healthy",
                  "color": "green",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textSize": {
          "title": 12,
          "value": 18
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "monitoring_service_health{instance=\"$instance\",service=~\"$service\"}",
          "legendFormat": "{{service}}",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "1 healthy; 0 unhealthy; -1 no completed health check. Shows the latest observation only."
    },
    {
      "id": 3,
      "title": "Application release",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "monitoring_application_info{instance=\"$instance\"}",
          "legendFormat": "{{version}}",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Shows the latest observation only."
    },
    {
      "id": 4,
      "title": "Application available",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 6
